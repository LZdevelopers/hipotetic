# Serviço de documentos: Node + LibreOffice (só o Writer, sem interface).
# Fontes métrico-compatíveis com as do Office (Liberation = Arial/Times/
# Courier, Carlito = Calibri, Caladea = Cambria) para o layout dos DOCX não
# "pular" na conversão.
FROM node:24-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      libreoffice-writer-nogui \
      fonts-liberation2 fonts-crosextra-carlito fonts-crosextra-caladea \
      fonts-dejavu-core fonts-noto-core \
 && apt-get clean && rm -rf /var/lib/apt/lists/* /usr/share/doc/* /usr/share/man/*

WORKDIR /app
COPY servidor.mjs ./
COPY perfil ./perfil

ENV NODE_ENV=production
EXPOSE 80
CMD ["node", "servidor.mjs"]
