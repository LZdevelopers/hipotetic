# Tudo opcional — sem nenhuma variável o site funciona por completo.

# Liga/desliga o download do YouTube. "off" volta ao modo só-prévia (player
# oficial + aviso), sem tocar no código. Padrão: ligado.
YOUTUBE_DOWNLOAD=

# Duração máxima (em minutos) de vídeos do YouTube para download. Padrão: 120.
# Os bytes passam pelas funções da Vercel, então este é o freio do tráfego.
YOUTUBE_MAX_MINUTOS=

# Liga/desliga o download do TikTok. "off" volta ao modo só-prévia (player
# oficial + aviso). Padrão: ligado.
TIKTOK_DOWNLOAD=
