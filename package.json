{
  "name": "hipotetic",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Plataforma da LZdev de ferramentas de arquivo: vídeo, áudio, imagem, PDF, documentos e compactados (nome provisório)",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/servidor.jsx --outDir dist-ssr && node dev/prerenderizar.mjs",
    "preview": "vite preview",
    "test": "node --test \"testes/**/*.test.mjs\"",
    "test:paginas": "node dev/testar-paginas.mjs"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "bgutils-js": "^4.0.3",
    "fflate": "^0.8.3",
    "file-type": "^22.3.0",
    "jsdom": "^26.1.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "youtubei.js": "^18.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.7"
  }
}
