    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/oxipng": "^2.3.0",
    "@jsquash/webp": "^1.5.0",
    "@neslinesli93/qpdf-wasm": "^0.3.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "7z-wasm": "^1.2.0",
    "bgutils-js": "^4.0.3",
    "diff": "^9.0.0",
    "docx-preview": "^0.4.1",
    "exifr": "^7.1.3",
    "fflate": "^0.8.3",
    "file-type": "^22.3.0",
    "hash-wasm": "^4.12.0",
    "jsdom": "^26.1.0",
    "lucide-react": "^1.70.0",
    "marked": "^18.1.3",
    "mediabunny": "^1.65.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0",
    "youtubei.js": "^18.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.7"
  }
